<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="640.0" style="-fx-background-color: linear-gradient(to bottom right, #5CE1E6, #0A47A9);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto0din.controller.ClienteController">
   <children>
      <VBox alignment="CENTER" maxHeight="440.0" maxWidth="520.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 16;">
         <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
         </padding>
         <effect>
            <DropShadow color="#00000040" offsetY="6.0" radius="20.0" />
         </effect>
         <children>
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0A47A9;" text="Área de cliente" />
            <Label fx:id="lblBienvenida" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" text="Bienvenido a tu espacio personal" />
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="10.0" style="-fx-background-color: #EAF8F8; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #16A6AE;" text="CUENTA ACTIVA" />
                  <Label style="-fx-text-fill: #526273;" text="Has iniciado sesión correctamente." />
               </children>
            </HBox>
            <Button maxWidth="1.7976931348623157E308" onAction="#cerrarSesion" prefHeight="40.0" style="-fx-background-color: #0A47A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Cerrar sesión" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
