<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ScrollPane exterior: permite desplazarse si la ventana es pequeña -->

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="400.0" prefWidth="600.0" style="-fx-background: transparent; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto0din.controller.RegistroController">
   <content>
      <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, #5CE1E6, #0A47A9);">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>

            <!-- Tarjeta blanca del formulario -->
            <VBox alignment="CENTER" maxWidth="-Infinity" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 16;">
               <padding>
                  <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
               </padding>
               <effect>
                  <DropShadow color="#00000040" offsetY="6.0" radius="20.0" />
               </effect>
               <children>
                  <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0A47A9;" text="Registrarse" />
                  <Label style="-fx-text-fill: #6B7280;" text="Crea una cuenta para continuar" />

                  <GridPane hgap="14.0" vgap="4.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="220.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="220.0" />
                     </columnConstraints>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <children>
                        <!-- Fila 1: nombre y apellido -->
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombre" maxWidth="1.7976931348623157E308" promptText="Ana" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Apellido" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="txtApellido" maxWidth="1.7976931348623157E308" promptText="Garcia" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <!-- Fila 2: DNI y email -->
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="DNI" GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <TextField fx:id="txtDni" maxWidth="1.7976931348623157E308" promptText="12345678A" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Email" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <TextField fx:id="txtEmail" maxWidth="1.7976931348623157E308" promptText="tucorreo@ejemplo.com" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <!-- Fila 3: contraseña y confirmación -->
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="4">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <PasswordField fx:id="txtPassword" maxWidth="1.7976931348623157E308" promptText="Mínimo 6 caracteres" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Repite la contraseña" GridPane.columnIndex="1" GridPane.rowIndex="4">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <PasswordField fx:id="txtConfirmar" maxWidth="1.7976931348623157E308" promptText="••••••••" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <!-- Fila 4: país y teléfono -->
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="País" GridPane.columnIndex="0" GridPane.rowIndex="6">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <ComboBox fx:id="cmbPais" maxWidth="1.7976931348623157E308" promptText="Selecciona un país" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 4;" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Teléfono" GridPane.columnIndex="1" GridPane.rowIndex="6">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <TextField fx:id="txtTelefono" maxWidth="1.7976931348623157E308" promptText="600123456" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <!-- Fila 5: tarjeta (opcional) -->
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Tarjeta (opcional)" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="8">
                           <GridPane.margin>
                              <Insets top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <TextField fx:id="txtTarjeta" maxWidth="1.7976931348623157E308" promptText="Solo números" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 9;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="9" />
                     </children>
                  </GridPane>

                  <HBox spacing="10.0">
                     <VBox.margin>
                        <Insets top="14.0" />
                     </VBox.margin>
                     <children>
                        <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrar" prefHeight="40.0" style="-fx-background-color: #0A47A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Crear cuenta" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#volverAlLogin" prefHeight="40.0" style="-fx-background-color: white; -fx-text-fill: #0A47A9; -fx-font-weight: bold; -fx-font-size: 14px; -fx-border-color: #0A47A9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver al inicio de sesión" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
