<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="18.0" style="-fx-background-color: linear-gradient(to bottom right, #5CE1E6, #0A47A9);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto0din.controller.RegistroController">
   <children>
      <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 16;">
         <padding>
            <Insets bottom="36.0" left="42.0" right="42.0" top="36.0" />
         </padding>
         <effect>
            <DropShadow color="#00000040" offsetY="6.0" radius="20.0" />
         </effect>
         <children>
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0A47A9;" text="Registrarse" />
            <Label style="-fx-text-fill: #6B7280;" text="Crea una cuenta para continuar" />
            <Button mnemonicParsing="false" onAction="#volverAlLogin" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #0A47A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver al inicio de sesión" />
         </children>
      </VBox>
   </children>
</VBox>